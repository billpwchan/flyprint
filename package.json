{
  "name": "flyprint",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-data.mjs && node scripts/build-basemap.mjs",
    "dev": "vinext dev",
    "prebuild": "node scripts/prepare-data.mjs && node scripts/build-basemap.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "logos:check": "node scripts/audit-carrier-assets.mjs",
    "test": "node scripts/run-demo.mjs test:product",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work --ignore-pattern data",
    "privacy:check": "node scripts/privacy-check.mjs",
    "aircraft:apply": "node scripts/apply-aircraft-evidence.mjs",
    "aircraft:audit": "node scripts/audit-aircraft-evidence.mjs",
    "aircraft:queue": "node scripts/list-unresolved-aircraft.mjs",
    "dev:demo": "node scripts/run-demo.mjs dev",
    "build:demo": "node scripts/run-demo.mjs build",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/repository-tools.test.mjs tests/trips.test.mjs",
    "test:product": "npm run test:unit && npm run logos:check && npm run build && node --test tests/rendered-html.test.mjs tests/accounts.test.mjs tests/weather.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "verify": "node scripts/run-demo.mjs verify:demo",
    "verify:demo": "npm run privacy:check && npm run docs:check && npm run lint && npm run typecheck && npm test",
    "export:public": "node scripts/export-open-source.mjs",
    "basemap": "node scripts/build-basemap.mjs --force",
    "lights": "node scripts/build-lights.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.6",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "geojson-vt": "^5.0.4",
    "globals": "16.4.0",
    "opencc-js": "^1.0.5",
    "react-server-dom-webpack": "^19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vinext": "^1.4.6",
    "vite": "^8.3.8",
    "vt-pbf": "^3.1.3"
  },
  "type": "module",
  "description": "隐私优先的个人与双人飞行档案：常驻地球、自动推断的行程、年度回顾与足迹。",
  "license": "MIT",
  "keywords": [
    "flight-journal",
    "aviation",
    "data-visualization",
    "react",
    "self-hosted",
    "travel",
    "vinext",
    "maplibre"
  ]
}
