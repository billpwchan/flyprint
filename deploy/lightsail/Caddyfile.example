# Merge this site block into the existing HTTPS gateway. Replace the host with
# your own domain and keep the application service on the shared Docker network.
flightlog.example.com {
	encode zstd gzip
	reverse_proxy flightlog-app:3000 {
		header_up X-Nonce "{http.request.uuid}"
		header_up Content-Security-Policy "default-src 'self'; script-src 'self' 'nonce-{http.request.uuid}' 'strict-dynamic'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://t.plnspttrs.net; font-src 'self' data:; connect-src 'self' https://api.planespotters.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'nonce-{http.request.uuid}' 'strict-dynamic'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://t.plnspttrs.net; font-src 'self' data:; connect-src 'self' https://api.planespotters.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}
