# Copy to .env.local for `npm run dev` and `npm start`, or to .env next to
# compose.yaml for Docker. Every value is optional; leave a line empty to skip it.

# Reads screenshots, PDFs and tables Flyprint cannot parse itself, with Claude.
# Without it, every other format still imports.
ANTHROPIC_API_KEY=

# Folder for the SQLite database (default: data/app). Docker sets /data.
FLYPRINT_DATA_DIR=

# The address people use to reach the site, for public pages, link previews,
# the sitemap and mail. Without it, the request's Host header is used.
FLYPRINT_ORIGIN=

# Contact address printed at the end of the privacy policy and terms.
FLYPRINT_CONTACT=

# Password reset by mail through Resend. Set both, plus FLYPRINT_ORIGIN.
# MAIL_FROM looks like: Flyprint <no-reply@example.com>
RESEND_API_KEY=
MAIL_FROM=

# City satellite pictures and city centres. The default imagery, EOX's
# Sentinel-2 cloudless 2024, is CC BY-NC-SA 4.0: non-commercial use only.
# A commercial site points this at imagery it may use.
# FLYPRINT_IMAGERY_UPSTREAM=
# FLYPRINT_GAZETTEER_UPSTREAM=
